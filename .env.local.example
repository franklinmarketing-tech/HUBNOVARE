# Copie este arquivo para .env.local e preencha.
# .env.local NUNCA vai para o git.

# Supabase da Novare (mesmo projeto do novareapp: hjikeevfzfswqydduars)
NEXT_PUBLIC_SUPABASE_URL=https://hjikeevfzfswqydduars.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# URL pública do Hub (usada em metadata/OG e nos links de e-mail do Supabase).
# Em producao TEM que ser o dominio real: sem isso os previews de link
# (WhatsApp/LinkedIn) apontam para localhost e o sitemap sai com dominio errado.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave da OpenAI: alimenta a Iris, o preenchimento automatico e as dicas do
# robo da home. Sem ela o Hub continua funcionando, mas esses recursos somem
# da tela (as rotas devolvem 503 e o componente se esconde).
OPENAI_API_KEY=

# URL base do checkout das CONSULTORIAS (lib/payment.ts, split de socios).
# Nao e a assinatura: essa tem links proprios, logo abaixo.
CHECKOUT_BASE_URL=

# --- Checkout da ASSINATURA (Hotmart) ---------------------------------
# Sao DOIS links, um por oferta: na Hotmart cada oferta tem endereco proprio
# (pay.hotmart.com/...?off=xxxx). Nao existe URL unica que sirva aos dois
# planos — querystring de valor nao muda o que a plataforma cobra.
#
# Precisam do prefixo NEXT_PUBLIC_ porque o botao de assinar e renderizado em
# componente de cliente: sem o prefixo a variavel some do bundle e todo botao
# cai na tela de em breve mesmo com a oferta no ar.
#
# Enquanto uma delas estiver vazia, o botao daquele plano leva para
# /assinar/em-breve, que mostra preco e garantia e oferece a demo do FINCASH.
# Preencheu, o mesmo botao passa a levar para a Hotmart, sem mexer em codigo.
#
# ATENCAO: nao configurar trial na oferta. A promessa e garantia de 7 dias
# (cobra e devolve), nao teste gratis. E conferir o prazo de reembolso da
# oferta em 7 dias: a devolucao e automatica pela Hotmart, e e isso que a
# pagina promete.
NEXT_PUBLIC_CHECKOUT_HOTMART_MENSAL=
NEXT_PUBLIC_CHECKOUT_HOTMART_ANUAL=

# Resend — envio de e-mail. Ja era usada por `lib/email.ts` e faltava aqui.
# Sem ela: o parecer do consultor continua sendo salvo e aparece no app do
# cliente, e o aviso no sino continua saindo. So o e-mail nao vai — e a tela do
# consultor diz isso, em vez de fingir que enviou.
RESEND_API_KEY=


# ── Assistente de WhatsApp (FINCASH) ────────────────────────────────────
# Passo a passo completo em `docs/whatsapp.md`. Nada aqui e obrigatorio para o
# Hub subir: sem estas variaveis o webhook responde 503 e o resto do app nao
# muda em nada.

# Chave de SERVICO do Supabase (Settings > API > service_role).
# O webhook chega sem sessao de navegador: nao ha cookie, nao ha auth.uid(), e
# por isso nenhuma policy de RLS se aplica a ele. Esta chave e a unica forma de
# gravar o lancamento na conta certa.
# ⚠️ Ela passa POR CIMA de todo o RLS. Nunca prefixar com NEXT_PUBLIC_, nunca
# usar fora de `lib/fincash/whatsapp-servidor.ts`, nunca colar numa tela.
SUPABASE_SERVICE_ROLE_KEY=

# Qual provedor esta plugado. Hoje so existe adaptador para "meta" (Cloud API).
# Outro provedor entra em `whatsapp-provedor.ts`, sem mexer no resto.
WHATSAPP_PROVEDOR=meta

# Token que VOCE inventa e repete no painel da Meta. Serve so para o handshake
# de verificacao da URL (o GET no webhook).
WHATSAPP_VERIFY_TOKEN=

# App Secret do app da Meta. E o segredo do HMAC que assina cada webhook.
# ⚠️ SEM ELE O WEBHOOK RECUSA TUDO EM PRODUCAO (503), de proposito: rota publica
# sem assinatura deixa qualquer um lancar gasto na conta de qualquer cliente.
WHATSAPP_APP_SECRET=

# Token de acesso permanente do usuario de sistema, para ENVIAR mensagem.
# Sem ele o assistente continua interpretando e gravando o lancamento — so nao
# responde (a resposta fica registrada em `fin_whatsapp_mensagens`).
WHATSAPP_TOKEN=

# Phone Number ID do numero. NAO e o telefone: e o id numerico do painel.
WHATSAPP_PHONE_NUMBER_ID=

# Versao da Graph API. Fixa de proposito: a Meta aposenta versao sem avisar.
WHATSAPP_API_VERSION=v21.0

# O numero do assistente, so para a tela dizer para onde mandar o codigo.
# Publico por natureza — e o numero que a pessoa vai salvar na agenda.
NEXT_PUBLIC_WHATSAPP_NUMERO=

# Quantos audios + fotos cada usuario pode mandar por MES no assistente.
# Vazio = 60 (~2 por dia), que cobre o uso real e ainda tampa o caso que quebra
# a conta: mandar todo comprovante do dia em foto, todo dia. Transcricao e visao
# custam POR MENSAGEM, todo mes, por assinante — assinatura e preco fixo, uso
# nao e.
# `0` DESLIGA audio e foto (o assistente volta a pedir texto), sem remover
# codigo: e o botao de emergencia se a conta da OpenAI assustar no primeiro mes.
# ⚠️ 60 e padrao PROVISORIO. O numero definitivo depende do preco da assinatura,
# que nao e decisao de codigo.
FINCASH_MIDIA_TETO_MES=
